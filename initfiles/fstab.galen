# Android fstab file.
#<src>                                                  <mnt_point>         <type>    <mnt_flags>                                                                         <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

system                           /system             ext4      ro,barrier=1,discard                                                wait,avb=vbmeta_system,slotselect,logical,first_stage_mount
system_ext                       /system_ext         ext4      ro,barrier=1,discard                                                wait,avb=vbmeta_system,slotselect,logical,first_stage_mount
product                          /product            ext4      ro,barrier=1,discard                                                wait,avb=vbmeta_system,slotselect,logical,first_stage_mount
vendor                           /vendor             ext4      ro,barrier=1,discard                                                wait,avb,slotselect,logical,first_stage_mount
odm                              /odm                ext4      ro,barrier=1,discard                                                wait,avb,slotselect,logical,first_stage_mount
/dev/block/by-name/misc          /misc               emmc      defaults                                                            defaults
/dev/block/by-name/userdata      /data               ext4      noatime,nosuid,nodev,discard,data=ordered,barrier=0,noauto_da_alloc latemount,wait,check,formattable,quota
/dev/block/by-name/metadata      /metadata           ext4      noatime,nosuid,nodev,discard                                        wait,check,formattable,first_stage_mount
/devices/platform/tegra-xhci*    auto                vfat      defaults                                                            voldmanaged=usbdrive:auto,encryptable=userdata
/devices/tegra-ehci*             auto                vfat      defaults                                                            voldmanaged=usbdrive:auto,encryptable=userdata
